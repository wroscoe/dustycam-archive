# Experiment overlay for the 2026-09-15 crash (docs/crash_experiment_2026-09-16.md).
# NOT for field images: comprehensive poisoning is slow and changes heap layout.
# Build: SDKCONFIG_DEFAULTS='sdkconfig.defaults;sdkconfig.secrets;sdkconfig.crashdebug'
CONFIG_DUSTY_CRASH_DEBUG=y
CONFIG_HEAP_POISONING_COMPREHENSIVE=y
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y
