#!/usr/bin/env python3
"""contractgen: turn contracts/ into committed constants for each language.

    tools/contractgen            rewrite contracts/gen/
    tools/contractgen --check    exit 1 if contracts/gen/ is stale (CI)

The generated files are committed so that a firmware or APK build never has to
run this. CI runs --check, so a hand-edit of a generated file fails the build.

Emits, from contracts/{meta,ble/gatt,mesh/lines}.toml:

    contracts/gen/python/dusty_contract.py   MicroPython + CPython (hub, tests)
    contracts/gen/c/dusty_contract.h         ESP-IDF components
    contracts/gen/java/Contract.java         the Android app

Deliberately constants only, not schema validation: MicroPython has no schema
library and the device just needs the key names, flags and limits. Schema
checking happens host-side in tests, against contracts/vectors/.

See docs/REPO_PLAN.md §2.
"""
import argparse
import sys
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
CONTRACTS = ROOT / 'contracts'
GEN = CONTRACTS / 'gen'

BANNER = 'GENERATED by tools/contractgen from contracts/ — do not edit.'


def load():
    def t(p):
        return tomllib.loads((CONTRACTS / p).read_text())
    return t('meta.toml'), t('ble/gatt.toml'), t('mesh/lines.toml')


def py_lit(v):
    return repr(v)


def gen_python(meta, gatt, mesh):
    L = ['"""%s' % BANNER, '',
         'Contract version: %s' % version(), '"""', '']
    L += ['META_ORDER = %s' % py_lit(meta['order']),
          'META_KEYS = frozenset(META_ORDER)',
          'META_TYPES = %s' % py_lit({k: v['type'] for k, v in meta['keys'].items()}),
          'WHY_VALUES = %s' % py_lit(meta['why']['values']),
          '']
    f, lim, fl = gatt['frame'], gatt['frame']['limits'], gatt['frame']['flags']
    L += ['BLE_PROTO = %d' % gatt['proto'],
          'BLE_UUID_BASE_FMT = %s' % py_lit(gatt['service']['uuid_base']),
          'BLE_CHARS = %s' % py_lit(gatt['characteristics']),
          'BLE_HEADER_LEN = %d' % f['header_len'],
          'BLE_ATT_OVERHEAD = %d' % f['att_overhead'],
          'BLE_BIN_PREFIX_LEN = %d' % f['bin_prefix_len'],
          'BLE_FLAG_LAST = 0x%02x' % fl['last'],
          'BLE_FLAG_BIN = 0x%02x' % fl['bin'],
          'BLE_FLAG_ERR = 0x%02x' % fl['err'],
          'BLE_LIMIT_REQUEST = %d' % lim['request'],
          'BLE_LIMIT_RESPONSE = %d' % lim['response'],
          'BLE_LIMIT_DATA = %d' % lim['data'],
          '']
    L += ['MESH_UPLINK = %s' % py_lit({k: v['pattern'] for k, v in mesh['uplink'].items()}),
          'MESH_DOWNLINK = %s' % py_lit(mesh['downlink']['pattern']),
          'MESH_COMMANDS = %s' % py_lit(mesh['downlink']['commands']),
          'MESH_RX_WINDOW_MS = %d' % mesh['downlink']['window_ms'],
          '']
    return '\n'.join(L)


def gen_c(meta, gatt, mesh):
    f, lim, fl = gatt['frame'], gatt['frame']['limits'], gatt['frame']['flags']
    L = ['/* %s' % BANNER, ' * Contract version: %s' % version(), ' */',
         '#ifndef DUSTY_CONTRACT_H', '#define DUSTY_CONTRACT_H', '']
    L += ['/* frame meta (%d keys, wire order) */' % len(meta['order'])]
    for k in meta['order']:
        L.append('#define DUSTY_META_KEY_%-10s "%s"' % (k.upper(), k))
    L += ['#define DUSTY_META_COUNT %du' % len(meta['order']), '']
    L += ['/* BLE GATT + framing */',
          '#define DUSTY_BLE_PROTO %du' % gatt['proto'],
          '#define DUSTY_BLE_UUID_BASE_FMT "%s"' % gatt['service']['uuid_base']]
    for name, xx in gatt['characteristics'].items():
        L.append('#define DUSTY_BLE_CHAR_%-8s 0x%02xu' % (name.upper(), xx))
    L += ['#define DUSTY_BLE_HDR_LEN %du' % f['header_len'],
          '#define DUSTY_BLE_ATT_OVERHEAD %du' % f['att_overhead'],
          '#define DUSTY_BLE_BIN_PREFIX_LEN %du' % f['bin_prefix_len'],
          '#define DUSTY_BLE_FLAG_LAST 0x%02xu' % fl['last'],
          '#define DUSTY_BLE_FLAG_BIN  0x%02xu' % fl['bin'],
          '#define DUSTY_BLE_FLAG_ERR  0x%02xu' % fl['err'],
          '#define DUSTY_BLE_LIMIT_REQUEST  %du' % lim['request'],
          '#define DUSTY_BLE_LIMIT_RESPONSE %du' % lim['response'],
          '#define DUSTY_BLE_LIMIT_DATA     %du' % lim['data'],
          '', '#endif /* DUSTY_CONTRACT_H */', '']
    return '\n'.join(L)


def gen_java(meta, gatt, mesh):
    f, lim, fl = gatt['frame'], gatt['frame']['limits'], gatt['frame']['flags']
    L = ['// %s' % BANNER, '// Contract version: %s' % version(),
         'package com.dustycam.phone;', '',
         'public final class Contract {', '    private Contract() {}', '']
    L += ['    public static final int BLE_PROTO = %d;' % gatt['proto'],
          '    public static final String BLE_UUID_BASE_FMT = "%s";' % gatt['service']['uuid_base']]
    for name, xx in gatt['characteristics'].items():
        L.append('    public static final int BLE_CHAR_%s = 0x%02x;' % (name.upper(), xx))
    L += ['    public static final int BLE_HEADER_LEN = %d;' % f['header_len'],
          '    public static final int BLE_ATT_OVERHEAD = %d;' % f['att_overhead'],
          '    public static final int BLE_BIN_PREFIX_LEN = %d;' % f['bin_prefix_len'],
          '    public static final int BLE_FLAG_LAST = 0x%02x;' % fl['last'],
          '    public static final int BLE_FLAG_BIN  = 0x%02x;' % fl['bin'],
          '    public static final int BLE_FLAG_ERR  = 0x%02x;' % fl['err'],
          '    public static final int BLE_LIMIT_REQUEST  = %d;' % lim['request'],
          '    public static final int BLE_LIMIT_RESPONSE = %d;' % lim['response'],
          '    public static final int BLE_LIMIT_DATA     = %d;' % lim['data'],
          '']
    keys = ', '.join('"%s"' % k for k in meta['order'])
    L += ['    public static final String[] META_ORDER = { %s };' % keys,
          '}', '']
    return '\n'.join(L)


def version():
    return (CONTRACTS / 'VERSION').read_text().strip()


OUTPUTS = [
    ('python/dusty_contract.py', gen_python),
    ('c/dusty_contract.h', gen_c),
    ('java/Contract.java', gen_java),
]


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--check', action='store_true',
                    help='exit 1 if any generated file differs from what this would write')
    args = ap.parse_args()

    meta, gatt, mesh = load()
    stale = []
    for rel, fn in OUTPUTS:
        want = fn(meta, gatt, mesh)
        path = GEN / rel
        have = path.read_text() if path.exists() else None
        if args.check:
            if have != want:
                stale.append(rel)
        elif have != want:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(want)
            print('wrote contracts/gen/%s' % rel)

    if args.check:
        if stale:
            sys.exit('contracts/gen is stale (%s). Run tools/contractgen.'
                     % ', '.join(stale))
        print('contracts/gen up to date (contract v%s)' % version())


if __name__ == '__main__':
    main()
