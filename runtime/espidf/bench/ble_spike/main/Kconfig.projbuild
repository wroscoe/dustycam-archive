menu "ble_spike"
    config DUSTY_DEVICE
        string "device id (blob path + firmware identity)"
        default "xiaocam1"
    config DUSTY_WIFI_SSID
        string "hotspot SSID"
        default ""
    config DUSTY_WIFI_PASS
        string "hotspot password"
        default ""
    config DUSTY_SERVER_HOST
        string "sensorhub host"
        default ""
    config DUSTY_SERVER_PORT
        int "sensorhub port"
        default 10000
    config DUSTY_SERVER_TLS
        bool "sensorhub over TLS (Funnel)"
        default y
    config DUSTY_BLOB_TOKEN
        string "X-Token for blob/telemetry/config/firmware"
        default ""
    config DUSTY_BLE_KEY
        string "dusty_ble owner key, 64 hex chars (32 raw bytes)"
        # Bench-only key (docs/phone_app_plan.md P0): the same value is
        # compiled into the phone app (Prefs.DEV_BLE_KEY_HEX) so hello/auth
        # work out of the box on the bench. PUBLIC, NOT A SECRET: it is
        # SHA-256 of "dustycam public bench BLE key - NOT A SECRET".
        # Never reuse this value for a real deployment.
        default "d2759966293ad602e12d68ec8a712703141a998ca2abf18e447fd11dc9630139"
endmenu
